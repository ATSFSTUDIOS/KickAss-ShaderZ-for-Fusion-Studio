local scriptPath = app:MapPath("Scripts:/Tool/KickAss ShaderZ/Substance PBR Import.lua")
if bmd.fileexists(scriptPath) == false then
	print("[Reactor Error] Open the Reactor window and update/re-install KickAss ShaderZ to download the missing file: " .. scriptPath)
else
	target:RunScript(scriptPath, {SelectAFile = true})
end
