						Background = Input {
							SourceOp = "GridBackground",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "TextMerge",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 330, 16.5 } },
					Version = 110
				},
