				UDIMTiler = Fuse.hos_Tiler {
					NameSet = true,
					Inputs = {
						Frames = Input {
							Value = 25,
							Expression = "(kas_PreviewUDIM.UTiles) * (kas_PreviewUDIM.VTiles)",
