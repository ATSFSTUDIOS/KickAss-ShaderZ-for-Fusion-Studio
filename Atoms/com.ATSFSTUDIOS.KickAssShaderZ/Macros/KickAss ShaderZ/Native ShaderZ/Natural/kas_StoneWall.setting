					Name = "AOMap",
				},
				SpecularTextureMap = InstanceInput {
					SourceOp = "SpecularInputSwitchElseFuse",
					Source = "Input1",
					Name = "SpecularMap",
				},
				DisplacementTextureMap = InstanceInput {
					SourceOp = "DisplacementInputSwitchElseFuse",
					Source = "Input1",
					Name = "DisplacementMap",
				}
			},
			Outputs = {
				DisplacementTextureOutput = InstanceOutput {
					SourceOp = "DisplacementInputSwitchElseFuse",
					Source = "Output",
					Name = "DisplacementTextureOutput",
				},
				MaterialOutput = InstanceOutput {
