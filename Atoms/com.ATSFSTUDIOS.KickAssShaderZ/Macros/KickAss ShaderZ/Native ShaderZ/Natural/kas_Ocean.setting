{
	Tools = ordered() {
		WaveMeshGenerator = GroupOperator {
			NameSet = true,
			Inputs = ordered() {
				Comments = Input { Value = "You can change the ocean state by selecting the \"WavesMeshGenerator\" group and modifying the UserControls on this node. These controls are linked directly to the \"WavesSetDomain\" node which is packaged inside the group.\n\nThe current settings are for a rougher water surface.\n\nWavesMeshGenerator Parameters:\n\nMap Resolution\nSets the resolution of the 2D displacement map. \n\nNoise Scale Multiplier\nSets the scale of the waves. A higher value means smaller waves. \n\nNoise Seethe Rate Multiplier\nSets the frequency of the waves. \n\nNoise Speed Multiplier\nSets the speed of the flow of the water.\n\n3D Image Plane Resolution\nSets the polygon count of the 3D image plane being rendered (also the test plane, relatively to the DoD). If this is equal to the Map Resolution it means that every pixel displaces 1 point in space. \n\n3D Displace Scale\nSets the amount with which the noise displaces the 3D Image Plane.\n\nWater Elevation\nBasically sets the brightness of the displacement map. Some noise setups can cause the water to be higher or lower than the image plane overall. Use this to compensate. \n\nOverall Smoothness\nSets the smoothness of the water, by blurring the noise maps before displacing.\n\nNoise Angle\nThe angle of the individual waves. They don't have a square aspect by default so the look and feel changes when using this slider - might help with repetitions in the overall pattern as well. \n\nWater Flow Angle\nChanges the direction in which the water flows. This setting has an angle control in the viewer as well. \n\nWave Sharpness\nPinches the tips of the waves together. Special Thanks to Robert Z!\n\nCopyright Credits:\n\nAnonymous Water Template \n\nThe Anonymous Water Template is the actual Fusion 3D water setup as it was used on Roland Emmerich's Anonymous (2011) film, courtesy of Uncharted Territory.\n\nSIGGRAPH 2012 Presentation on Anonymous:\nhttps://www.youtube.com/watch?v=mOpN6C3ZrjY" },
				TextureMapInput = InstanceInput {
					Name = "TextureMapInput",
					Source = "Input",
					SourceOp = "WaveNoiseInputPipeRouter"
				},
				MapResolution = InstanceInput {
					SourceOp = "WavesSetDomain",
					Source = "MapResolution",
					Default = 3024
				},
				DoDScale = InstanceInput {
					SourceOp = "WavesSetDomain",
					Source = "DoDScale",
					Default = 0.25
				},
				DoDCenter = InstanceInput {
					Source = "DoDCenter",
					SourceOp = "WavesSetDomain"
				},
				NoiseScaleMultiplier = InstanceInput {
					SourceOp = "WavesSetDomain",
					Source = "NoiseScaleMultiplier",
					Default = 1
				},
				NoiseSeetheRateMultiplier = InstanceInput {
