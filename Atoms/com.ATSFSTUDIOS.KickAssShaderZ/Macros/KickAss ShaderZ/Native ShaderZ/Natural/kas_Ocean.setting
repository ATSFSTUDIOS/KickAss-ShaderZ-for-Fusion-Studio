											},
											SmallWavesSmoothness = {
												LINKID_DataType = "Number",
												LINKS_Name = "Small Waves Smoothness",
												INP_Default = 1,
												INPID_InputControl = "SliderControl",
												INP_MaxScale = 100,
												INP_MinAllowed = 0
											}
										},
