			},
			Inputs = ordered() {
				Comments = Input { Value = "\"kas_VolcanicMagma\" creates a super hot molten rock material. When you render this material, consider attaching a 2D glow effect to highlight the surface cracks that are luminous.\n\nTo get the displacement effect out of this material you need to add a Displace3D node and connect its \"SceneInput\" input to a 3D model's \"3DData\" output connection. Then connect the \"kas_VolcanicMagma\" material' s \"DisplacementTextureOutput\" connection to the Displace3D node's \"Input\" connection. The strength of the displacement effect is controlled on the Displace3D node's scale attribute with a good starting value of approximately 0.2.", },
				AlbedoMap = InstanceInput {
					SourceOp = "AlbedoInputSwitchElseFuse",
					Source = "Input1",
					Name = "AlbedoMap",
				},
				DisplacementMap = InstanceInput {
					SourceOp = "DisplacementInputSwitchElseFuse",
					Source = "Input1",
					Name = "DisplacementMap",
